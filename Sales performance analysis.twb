      <aliases enabled='yes' />
      <column caption='Avg Monthly Sales' datatype='real' name='[Calculation_2326390710798831616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD(DATETRUNC(&apos;month&apos;, [Order.Date]))' />
      </column>
      <column caption='Region Rank' datatype='integer' name='[Calculation_2326390710802939907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='region rank' datatype='integer' name='[Calculation_2326390710824943626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='unique region rank' datatype='integer' name='[Calculation_2326390712401551387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Region Insight' datatype='string' name='[Calculation_2326390712403775521]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Top Region: &quot; + MAX([Region]) +&#13;&#10;&quot; with Sales ₹&quot; + STR(INT(SUM([Sales])))' />
      </column>
      <column caption='region insight' datatype='string' name='[Calculation_2326390712404754469]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Top Region: &quot; + MAX([Region]) +&#13;&#10;&quot; with Sales ₹&quot; + STR(INT(SUM([Sales])))' />
      </column>
      <column caption='Top Region Insight-dynamic' datatype='string' name='[Calculation_2326390712413499432]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2326390712401551387] = 1 THEN&#13;&#10;    &quot;Top Region: &quot; + MIN([Region]) +&#13;&#10;    &quot; with Sales ₹&quot; + STR(INT(SUM([Sales])))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Rank' datatype='integer' name='[Calculation_2326390712418205741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Category Insight' datatype='string' name='[Calculation_2326390712418615342]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2326390712418205741] = 1 THEN&#13;&#10;    &quot;Top Category: &quot; + &#13;&#10;    MIN([Category]) + &#13;&#10;    &quot; with Sales ₹&quot; + &#13;&#10;    STR(INT(SUM([Sales])))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Sales' datatype='integer' name='[Calculation_2326390712424325169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
