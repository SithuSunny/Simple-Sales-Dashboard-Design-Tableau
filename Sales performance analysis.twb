      <column caption='Peak Month Flag' datatype='string' name='[Calculation_2326390712424394802]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(SUM([Sales])) = 1 THEN &quot;Peak&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Peak Insight' datatype='string' name='[Calculation_2326390712424714291]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(SUM([Sales])) = 1 THEN&#13;&#10;  &quot;Sales peaked in &quot; + DATENAME(&apos;month&apos;, MIN([Order.Date])) +&#13;&#10;  &quot; with ₹&quot; + STR(INT(SUM([Sales]))) + &quot; in sales.&quot;&#13;&#10;END'>
